# demo = simulador explícito; ollama = LLM real local.
CATIA_PROVIDER=demo
CATIA_ORCHESTRATION=react
CATIA_MEMORY_WINDOW=3
# CATIA_MEMORY_DB=runtime/memory.sqlite3
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# lexical = TF-IDF; hybrid = TF-IDF + embeddings reales de Ollama.
CATIA_RETRIEVER=lexical
OLLAMA_EMBED_MODEL=nomic-embed-text
